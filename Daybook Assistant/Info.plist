<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CKSharingSupported</key>
	<true/>
	<!--
	  Which CloudKit environment this build syncs with: the CLOUDKIT_ENVIRONMENT
	  build setting, which also sets the icloud-container-environment
	  entitlement. Read at runtime by CloudKitEnvironment (store folder and
	  per-environment sync keys). Keep the two in step by never editing either
	  by hand.
	-->
	<key>CloudKitEnvironment</key>
	<string>$(CLOUDKIT_ENVIRONMENT)</string>
	<!--
	  The Home Screen name is just "Assistant" (CFBundleDisplayName build
	  setting). Siri's App Shortcut phrases use the display name, so keep
	  "Daybook Assistant" as a spoken alternative: the phrases the setup flow
	  teaches ("Mark Maya here in Daybook Assistant") keep working.
	-->
	<key>INAlternativeAppNames</key>
	<array>
		<dict>
			<key>INAlternativeAppName</key>
			<string>Daybook Assistant</string>
		</dict>
	</array>
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
	</array>
	<key>UILaunchScreen</key>
	<dict/>
</dict>
</plist>

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>aps-environment</key>
	<string>development</string>
	<!--
	  CloudKit environment, from the CLOUDKIT_ENVIRONMENT build setting
	  (Production for Debug and Release since the notebook's move on
	  2026-09-28). Honoured by development-signed builds; TestFlight and App
	  Store builds always use Production whatever this says. The same setting names the store folder
	  (CoreDataStack.storeDirectory), so each environment keeps its own files.
	-->
	<key>com.apple.developer.icloud-container-environment</key>
	<string>$(CLOUDKIT_ENVIRONMENT)</string>
	<!--
	  The container is spelled out, NOT derived from the bundle identifier the
	  way the main app's entitlements do it. This app's bundle id ends in
	  ".Assistant", so the derived form would resolve to a brand new, empty
	  container and the assistant would sit staring at an empty classroom
	  forever. It must be the guide's existing container, verbatim.
	-->
	<key>com.apple.developer.icloud-container-identifiers</key>
	<array>
		<string>iCloud.DanielSDeBerry.MariasNoteBook</string>
	</array>
	<!--
	  iOS 26+ withholds the share owner's name unless this is present; with it
	  the Classroom screen and "Marked by" show the guide's name instead of
	  "Your guide". The Assistant's App ID needs the capability too, or signed
	  builds fail provisioning. Apple's terms: display it, never store it.
	-->
	<key>com.apple.developer.icloud-extended-share-access</key>
	<array>
		<string>InProcessShareOwnerParticipantInfo</string>
	</array>
	<key>com.apple.developer.icloud-services</key>
	<array>
		<string>CloudKit</string>
	</array>
	<key>com.apple.developer.ubiquity-kvstore-identifier</key>
	<string>$(TeamIdentifierPrefix)DanielSDeBerry.MariasNoteBook</string>
</dict>
</plist>

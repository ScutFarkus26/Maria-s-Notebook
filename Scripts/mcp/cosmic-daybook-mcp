#!/bin/sh
#
# cosmic-daybook-mcp — stdio bridge between an MCP client (Claude Desktop,
# Claude Code) and the MCP server inside the running Cosmic Daybook app.
#
# The app listens on loopback TCP (the App Sandbox cannot bind Unix
# sockets anywhere external clients could reach without TCC prompts).
# MCP clients speak newline-delimited JSON-RPC over stdio; a small Perl
# relay (macOS's own /usr/bin/perl, core modules only) passes the lines
# through verbatim after a one-line AUTH preamble carrying the per-install
# token the app wrote to ~/.cosmic-daybook/mcp.token.
#
# The relay outlives the app. When the app quits or restarts, it answers
# any request still waiting with a plain error (the app may have saved a
# change before it went), and the next request connects again, after the
# same checks and launch as below. Claude Desktop never restarts a bridge
# that exits, so a bridge that died with the app left every later call
# failing with no message until Claude itself was quit (2026-10-29).
#
# When the server is not up, the bridge launches the app — only when no
# copy is running already (a second copy would open the same store) and
# only when Claude access is switched on in the app's Settings (the app
# keeps ~/.cosmic-daybook/enabled in step with that toggle). That launch is
# MCP-only: no main window, and the app quits about ten minutes after the
# last Claude session disconnects. Set COSMIC_DAYBOOK_NO_AUTOLAUNCH=1 to
# never launch it. The copy it launches is /Applications/Cosmic Daybook.app
# (a Release build of main, put there by Scripts/install_release.sh) when
# that exists, and otherwise whichever copy macOS picks for the bundle id.
#
# Claude Desktop config (~/Library/Application Support/Claude/claude_desktop_config.json):
#   { "mcpServers": { "cosmic-daybook": { "command": "<absolute path to this script>" } } }
#
set -eu

# Before it connects again, the relay runs this script with
# COSMIC_DAYBOOK_BRIDGE_CHECK=1: the checks and launch below run as usual,
# their message comes back to the relay on stdout, and the script stops
# before relaying.
if [ -n "${COSMIC_DAYBOOK_BRIDGE_CHECK:-}" ]; then
    exec </dev/null 2>&1 >/dev/null
fi

BUNDLE_ID="DanielSDeBerry.MariasNoteBook"
PORT=43117
SUPPORT_DIR="$HOME/.cosmic-daybook"
TOKEN_FILE="$SUPPORT_DIR/mcp.token"
ENABLED_MARKER="$SUPPORT_DIR/enabled"
INSTALLED_APP="/Applications/Cosmic Daybook.app"

port_open() {
    /usr/bin/nc -z 127.0.0.1 "$PORT" >/dev/null 2>&1
}

# PIDs of every running copy of the app, found by bundle id through
# LaunchServices: whatever path or name a copy was built under, and without
# the Automation prompt that asking System Events would raise.
running_app_pids() {
    /usr/bin/lsappinfo find "bundleid=$BUNDLE_ID" 2>/dev/null \
        | /usr/bin/grep -o 'ASN:0x[0-9a-fA-F]*-0x[0-9a-fA-F]*' \
        | while read -r asn; do
            /usr/bin/lsappinfo info -only pid "$asn:" 2>/dev/null \
                | /usr/bin/sed -n 's/.*pid = \([0-9][0-9]*\).*/\1/p'
        done
}

# PIDs of the processes listening on the port.
port_holder_pids() {
    /usr/sbin/lsof -nP -t -iTCP:"$PORT" -sTCP:LISTEN 2>/dev/null || true
}

# A process stopped by a debugger or kill -STOP (ps state T) keeps its
# listening socket: the kernel still accepts connections, nothing answers.
is_stopped() {
    case "$(/bin/ps -o stat= -p "$1" 2>/dev/null || true)" in
        *T*) return 0 ;;
        *) return 1 ;;
    esac
}

# $1: the stopped pid; $2: what that means for this session.
refuse_stopped() {
    printf '%s\n' "$2" >&2
    printf 'Resume it (kill -CONT %s) or quit it (kill %s), then retry.\n' "$1" "$1" >&2
    exit 1
}

not_listening() {
    printf 'Cosmic Daybook MCP server is not listening on 127.0.0.1:%s\n' "$PORT" >&2
    printf 'Open the app and enable Claude Desktop access in Settings, then retry.\n' >&2
    exit 1
}

# An MCP-only launch, backgrounded without stealing focus. The app reads
# -CosmicDaybookMCPAutolaunch; -ApplePersistenceIgnoreState keeps macOS from
# reopening the last session's windows (AppKit says it leaves that saved
# state untouched for the next normal launch). Launch arguments are not
# persisted.
#
# The installed copy is opened by path. Every Xcode build registers another
# copy under the same bundle id — worktree builds of unmerged code among
# them — and `open -b` may pick any of them. If the installed copy is there
# but will not start, the wait below ends in "not listening" rather than
# falling back to one of those.
launch_app() {
    # With Claude access switched off the app would never listen.
    [ -e "$ENABLED_MARKER" ] || not_listening
    if [ -d "$INSTALLED_APP" ]; then
        set -- -a "$INSTALLED_APP"
    else
        set -- -b "$BUNDLE_ID"
    fi
    /usr/bin/open -g "$@" --args \
        -CosmicDaybookMCPAutolaunch YES -ApplePersistenceIgnoreState YES 2>/dev/null || true
}

if ! port_open && [ -z "${COSMIC_DAYBOOK_NO_AUTOLAUNCH:-}" ]; then
    pids=$(running_app_pids)
    if [ -n "$pids" ]; then
        # A copy is up already (still starting, say): never open a second
        # one on the same store; wait for it to listen instead.
        stopped=""
        for pid in $pids; do
            if is_stopped "$pid"; then stopped="$pid"; else stopped=""; break; fi
        done
        [ -z "$stopped" ] || refuse_stopped "$stopped" \
            "Cosmic Daybook (pid $stopped) is stopped (a debugger or kill -STOP), so it will never listen on 127.0.0.1:$PORT."
    else
        launch_app
    fi
    waited=0
    while ! port_open && [ "$waited" -lt 100 ]; do
        sleep 0.2
        waited=$((waited + 1))
        # The copy found above was quitting (an MCP-only launch that went
        # idle closes its port first): once it is gone, launch a fresh one.
        if [ -n "$pids" ] && [ -z "$(running_app_pids)" ]; then
            pids=""
            waited=0
            launch_app
        fi
    done
fi

if ! port_open; then
    not_listening
fi

for pid in $(port_holder_pids); do
    if is_stopped "$pid"; then
        refuse_stopped "$pid" \
            "The process listening on 127.0.0.1:$PORT (pid $pid) is stopped (a debugger or kill -STOP), so it would never answer."
    fi
done

if [ ! -r "$TOKEN_FILE" ]; then
    printf 'MCP auth token not found at %s\n' "$TOKEN_FILE" >&2
    printf 'Enable Claude Desktop access in the app'\''s Settings to create it.\n' >&2
    exit 1
fi

[ -z "${COSMIC_DAYBOOK_BRIDGE_CHECK:-}" ] || exit 0

# Send the AUTH line, then relay lines both ways until the client goes.
# Arguments: this script (to run the checks again), the port, the token file.
RELAY=$(cat <<'PERL'
use strict;
use warnings;
use IO::Socket::INET;
use IO::Select;
use JSON::PP;

my ($bridge, $port, $token_file) = @ARGV;
$SIG{PIPE} = 'IGNORE';
binmode STDIN;
binmode STDOUT;

my $json = JSON::PP->new->canonical->allow_nonref;
my $closed_message = "Cosmic Daybook closed before it answered (it quit or restarted). "
    . "If this was a change, check whether it was saved before you try again.";
my ($sock, $from_server, $from_client, $client_done) = (undef, '', '', 0);
# Requests sent to the app and not answered yet, by id (as JSON text).
my %pending;

sub write_all {
    my ($fh, $data) = @_;
    while (length $data) {
        my $n = syswrite($fh, $data);
        if (!defined $n) {
            next if $!{EINTR};
            return 0;
        }
        substr($data, 0, $n, '');
    }
    return 1;
}

# The client reading stdout has gone: nothing left to relay to.
sub to_client { write_all(\*STDOUT, "$_[0]\n") or exit 0 }

sub fail_request {
    my ($id, $message) = @_;
    to_client($json->encode({ jsonrpc => '2.0', id => $id,
        error => { code => -32000, message => $message } }));
}

sub one_line { my $text = shift; $text =~ s/\s+/ /g; $text =~ s/^ | $//g; $text }

sub connect_server {
    open(my $tf, '<', $token_file)
        or return (0, "Couldn't read the connection key. Turn on Claude Desktop access in Cosmic Daybook's Settings, then try again.");
    my $token = <$tf> // '';
    close($tf);
    $token =~ s/\s+\z//;
    my $s = IO::Socket::INET->new(PeerAddr => '127.0.0.1', PeerPort => $port, Proto => 'tcp')
        or return (0, "Couldn't reach Cosmic Daybook. Check that it's open, then try again.");
    binmode $s;
    write_all($s, "AUTH $token\n")
        or return (0, "Couldn't reach Cosmic Daybook. Check that it's open, then try again.");
    ($sock, $from_server) = ($s, '');
    return (1, '');
}

# Runs the bridge's own checks again (launching the app when it would),
# then connects.
sub reconnect {
    local $ENV{COSMIC_DAYBOOK_BRIDGE_CHECK} = 1;
    my $pid = open(my $check, '-|');
    return (0, "Couldn't reach Cosmic Daybook. Try again.") unless defined $pid;
    if ($pid == 0) {
        exec { $bridge } $bridge;
        exit 127;
    }
    my $said = do { local $/; <$check> } // '';
    close($check);
    return (0, one_line($said) || "Couldn't reach Cosmic Daybook. Check that it's open, then try again.")
        if $? != 0;
    return connect_server();
}

sub server_closed {
    close($sock);
    ($sock, $from_server) = (undef, '');
    print STDERR "Cosmic Daybook closed the connection; the next request connects again.\n";
    fail_request($_, $closed_message) for values %pending;
    %pending = ();
}

sub send_line {
    my ($line) = @_;
    my $message = eval { $json->decode($line) };
    my $is_request = ref $message eq 'HASH' && defined $message->{method} && exists $message->{id};
    if (!$sock) {
        my ($ok, $why) = reconnect();
        if (!$ok) {
            print STDERR "$why\n";
            fail_request($message->{id}, $why) if $is_request;
            return;
        }
        print STDERR "Connected to Cosmic Daybook again.\n";
    }
    $pending{$json->encode($message->{id})} = $message->{id} if $is_request;
    server_closed() unless write_all($sock, "$line\n");
}

# Splits complete lines off the front of a buffer.
sub take_lines {
    my ($buffer) = @_;
    my @lines;
    while ((my $i = index($$buffer, "\n")) >= 0) {
        my $line = substr($$buffer, 0, $i + 1, '');
        $line =~ s/\r?\n\z//;
        push @lines, $line if length $line;
    }
    return @lines;
}

sub read_client {
    my $n = sysread(STDIN, my $chunk, 65536);
    if (!defined $n) {
        return if $!{EINTR} || $!{EAGAIN};
        $n = 0;
    }
    if ($n == 0) {
        $client_done = 1;
        send_line($from_client) if length $from_client;
        shutdown($sock, 1) if $sock;
        return;
    }
    $from_client .= $chunk;
    send_line($_) for take_lines(\$from_client);
}

sub read_server {
    my $n = sysread($sock, my $chunk, 65536);
    if (!defined $n) {
        return if $!{EINTR} || $!{EAGAIN};
        $n = 0;
    }
    return server_closed() if $n == 0;
    $from_server .= $chunk;
    for my $line (take_lines(\$from_server)) {
        my $message = eval { $json->decode($line) };
        delete $pending{$json->encode($message->{id})}
            if ref $message eq 'HASH' && !defined $message->{method} && exists $message->{id};
        to_client($line);
    }
}

my ($ok, $why) = connect_server();
if (!$ok) {
    print STDERR "$why\n";
    exit 1;
}
while (1) {
    my $select = IO::Select->new();
    $select->add(\*STDIN) unless $client_done;
    $select->add($sock) if $sock;
    last unless $select->count;
    for my $fh ($select->can_read) {
        if ($sock && $fh == $sock) { read_server() } else { read_client() }
    }
    last if $client_done && (!$sock || !%pending);
}
exit 0;
PERL
)
exec /usr/bin/perl -e "$RELAY" "$0" "$PORT" "$TOKEN_FILE"

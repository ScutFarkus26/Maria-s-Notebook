<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>DanielSDeBerry.MariasNoteBook.backup</string>
	</array>
	<key>CKSharingSupported</key>
	<true/>
	<!--
	  Which CloudKit environment this build syncs with: the CLOUDKIT_ENVIRONMENT
	  build setting, which also sets the icloud-container-environment
	  entitlement. Read at runtime by CloudKitEnvironment (store folder and
	  per-environment sync keys). Keep the two in step by never editing either
	  by hand.
	-->
	<key>CloudKitEnvironment</key>
	<string>$(CLOUDKIT_ENVIRONMENT)</string>
	<key>NSUbiquitousContainers</key>
	<dict>
		<key>iCloud.$(CFBundleIdentifier)</key>
		<dict>
			<key>NSUbiquitousContainerIsDocumentScopePublic</key>
			<true/>
			<key>NSUbiquitousContainerName</key>
			<string>Cosmic Daybook</string>
			<key>NSUbiquitousContainerSupportedFolderLevels</key>
			<string>Any</string>
		</dict>
	</dict>
	<key>NSUserActivityTypes</key>
	<array>
		<string>DanielSDeBerry.MariasNoteBook.handoff.student</string>
		<string>DanielSDeBerry.MariasNoteBook.handoff.lesson</string>
		<string>DanielSDeBerry.MariasNoteBook.handoff.albumPage</string>
	</array>
	<key>UTExportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
			</array>
			<key>UTTypeDescription</key>
			<string>Cosmic Daybook Backup</string>
			<key>UTTypeIconFiles</key>
			<array/>
			<key>UTTypeIdentifier</key>
			<string>com.cosmic-daybook.backup</string>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>mtbbackup</string>
				</array>
			</dict>
		</dict>
	</array>
</dict>
</plist>
